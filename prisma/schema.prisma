generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Expense {
  dailyId       String?
  daily         DailyExpense? @relation(fields: [dailyId], references: [id], onDelete: Cascade)
  sortOrder     Int           @default(0)
  id            String        @id @default(cuid())
  amount        Int
  date          DateTime
  categoryId    String
  category      Category      @relation(fields: [categoryId], references: [id])
  subcategoryId String?
  subcategory   Subcategory?  @relation(fields: [subcategoryId], references: [id])
  merchant      String?
  memo          String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([dailyId])
  @@index([date])
  @@index([categoryId])
  @@index([subcategoryId])
}

model Category {
  fixedExpenses          FixedExpense[]
  recurringFixedExpenses RecurringFixedExpense[]
  budgets                CategoryBudget[]
  templates              ExpenseTemplate[]
  id                     String                  @id @default(cuid())
  name                   String                  @unique
  sortOrder              Int                     @default(0)
  subcategories          Subcategory[]
  expenses               Expense[]
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
}

model Income {
  id        String   @id @default(cuid())
  date      DateTime
  type      String
  amount    Int
  memo      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
  @@index([type])
}

model CategoryBudget {
  id         String   @id @default(cuid())
  month      String
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  amount     Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([month, categoryId])
  @@index([month])
  @@index([categoryId])
}

model ExpenseTemplate {
  id         String   @id @default(cuid())
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  amount     Int
  memo       String?
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([categoryId])
}

model Subcategory {
  id         String    @id @default(cuid())
  name       String
  categoryId String
  category   Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  sortOrder  Int       @default(0)
  expenses   Expense[]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([categoryId, name])
  @@index([categoryId])
}

model DailyExpense {
  id        String    @id @default(cuid())
  date      DateTime  @unique
  total     Int
  items     Expense[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model FixedMonth {
  month                String         @id
  items                FixedExpense[]
  recurringGeneratedAt DateTime?
  updatedAt            DateTime       @updatedAt
}

model FixedExpense {
  id          String                 @id @default(cuid())
  month       String
  period      FixedMonth             @relation(fields: [month], references: [month], onDelete: Cascade)
  categoryId  String
  category    Category               @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  amount      Int
  memo        String?
  dueDay      Int?
  recurringId String?
  recurring   RecurringFixedExpense? @relation(fields: [recurringId], references: [id], onDelete: SetNull)
  sortOrder   Int                    @default(0)

  @@unique([month, recurringId])
  @@index([month])
  @@index([categoryId])
  @@index([recurringId])
}

model RecurringFixedExpense {
  id         String         @id @default(cuid())
  categoryId String
  category   Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  amount     Int
  memo       String?
  dueDay     Int
  startMonth String
  active     Boolean        @default(true)
  sortOrder  Int            @default(0)
  items      FixedExpense[]
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([categoryId])
  @@index([startMonth])
}
